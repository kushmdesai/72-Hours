theme_override_font_sizes/font_size = 13
text = "Water ice, frozen here for billions of years.
Each pass of the drill brings up half as much as the last,
so a vein holds  a + ar + ar² + … = a / (1 − r)  litres.
Dig the dark coal seams to feed the coal generator."
horizontal_alignment = 1
